# ==== LLM + Embeddings (Google GenAI SDK, Gemini) ====
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ==== Local storage (no Docker, no external DB servers) ====
SQLITE_PATH=./app/data/scholaragent.db
CHROMA_PATH=./app/data/chroma_store
CHROMA_COLLECTION=scholaragent_papers

# ==== Web search tool ====
# Optional: if set, Tavily is used. If empty, falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=

# ==== App ====
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# ==== Evaluation ====
EVAL_TOP_K=5
